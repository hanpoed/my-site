{
  "version": 2,
  "builds": [
    {
      "src": "myprojet/api/**/*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "myprojet/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*\\.php)",
      "dest": "/myprojet/api/$1"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf))",
      "dest": "/myprojet/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/myprojet/api/index.php"
    }
  ]
}
